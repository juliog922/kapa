# =============================================================================
#  Production environment - copy to .env and set real values:
#    cp .env.example .env
#  NEVER commit .env
# =============================================================================
KAPA_ENV=prod

POSTGRES_VERSION=18
POSTGRES_USER=kapa
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=kapa
POSTGRES_PORT=5432

# WhatsApp gateway: gRPC on 127.0.0.1 only (other services use whatsapp:50051 inside compose)
WHATSAPP_GRPC_PORT=50051
WA_LOG_LEVEL=WARN
# 1 = also deliver "Message yourself" chat messages (useful for manual testing)
WA_SELF_CHAT=0
