# Environment (secrets)
.env
.env.*
!.env.example
!.env.dev

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Logs
*.log

# Services
services/*/.env.test
!services/*/.env.test.example
services/*/bench/
services/whatsapp/whatsapp

# Service secrets (app passwords...): never committed; only *.example.env files are
services/*/secrets/*
!services/*/secrets/*.example.env
services/*/target/
# Local test data exported from production systems (may contain personal data)
services/*/testdata/*.local.*
