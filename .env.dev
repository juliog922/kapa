# =============================================================================
#  Development / test environment - safe to commit (non-secret credentials).
#  `make test` publishes no host port, so it can run alongside production.
# =============================================================================
KAPA_ENV=dev

POSTGRES_VERSION=18
POSTGRES_USER=kapa_dev
POSTGRES_PASSWORD=kapa_dev
POSTGRES_DB=kapa_dev

# WhatsApp gateway: gRPC on 127.0.0.1 only (other services use whatsapp:50051 inside compose)
WHATSAPP_GRPC_PORT=50051
WA_LOG_LEVEL=WARN
# 1 = also deliver "Message yourself" chat messages (useful for manual testing)
WA_SELF_CHAT=0

# Core service: which secrets files it reads (services/core/secrets/{accounts,admin}.<CORE_SECRETS>.env)
CORE_SECRETS=prod

# Tachyon (local GPU inference): only hosts with an NVIDIA GPU and the NVIDIA Container
# Toolkit run it. Uncomment on prike:
#COMPOSE_PROFILES=gpu
# Seconds a model stays in VRAM after its last request; MiB of shared memory per client.
#TACHYON_KEEP_ALIVE=300
#TACHYON_DATA_MIB=64