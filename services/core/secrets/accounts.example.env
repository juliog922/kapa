# =============================================================================
#  Gmail ACCOUNTS of the core service - TEMPLATE (committed; real files are gitignored)
#
#    accounts.dev.env    OMEN16: local runs and tests
#    accounts.prod.env   production: uploaded to prike, never deployed by rsync
#
#  Every account here works like a WhatsApp account: it RECEIVES (IMAP, published
#  to the core stream through its allowlist) and SENDS (SMTP, from its own address).
#  The Kapa admin mailbox does NOT belong here: see admin.example.env.
#
#  Passwords are Google *app passwords* (16 letters; spaces are ignored):
#  Google Account > Security > 2-Step Verification (required) > App passwords.
# =============================================================================

# One line per account: ACCOUNT=<address>:<app password>
ACCOUNT=someone@gmail.com:abcd efgh ijkl mnop
ACCOUNT=sales@kapalua.es:qrst uvwx yzab cdef

# Servers (Gmail defaults; only change for another provider)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
