# =============================================================================
#  Sage SQL Server (read-only) for the core service - TEMPLATE (committed)
#
#    sqlserver.prod.env   uploaded with `make deploy-secrets`; the SQL Server is only
#                         reachable from the server, so this is the only file used
#                         (checks and samples run there: `make deploy-sync-sqlserver`)
#
#  core only runs SELECTs. Prefer a login with SELECT-only permissions.
# =============================================================================
SQLSERVER_HOST=192.168.1.249
SQLSERVER_PORT=1433
SQLSERVER_DB=Sage
SQLSERVER_USER=BOT
# Quotes are allowed (and needed if the password starts/ends with spaces)
SQLSERVER_PASSWORD="change-me"
# TLS: required (default) | login (only the login is encrypted) | none (old servers, LAN only)
SQLSERVER_ENCRYPT=required
# Accept the server's self-signed certificate (typical for an ERP server on the LAN)
SQLSERVER_TRUST_CERT=true
