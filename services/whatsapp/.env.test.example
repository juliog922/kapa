# Live WhatsApp integration tests. Copy to .env.test (gitignored) and set your test phone:
#   cp .env.test.example .env.test
# International format. This phone gets linked twice (make pair-test) and receives the
# test messages in its "Message yourself" chat.
WA_TEST_PHONE=
# 1 = also request (and cancel) a real pairing code on every test run. Off by default:
# WhatsApp rate-limits code requests per number (429), and a limited number cannot link.
WA_TEST_PAIRING=0
# whatsmeow log level during tests: DEBUG, INFO, WARN, ERROR
WA_LOG_LEVEL=WARN
