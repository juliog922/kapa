# Paths never shipped to the deployment host (rsync --exclude-from).
# Excluded paths are also protected from rsync --delete on the host,
# which is what keeps the production /.env and /.release in place.
/.git/
/.github/
/.env*
/.release
/docs/
/.editorconfig
/.deployignore
.env.test
.env.test.example
/services/*/bench/
/services/*/*_test.go
/services/*/scripts/
/services/*/.golangci.yml
/proto/
/scripts/ci/
